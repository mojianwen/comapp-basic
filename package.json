{
  "name": "mo-admin-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mo/demo",
    "build:single": "npm run build:single --workspace @mo/demo",
    "start": "scripts\\start.bat",
    "stop": "scripts\\stop.bat",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
